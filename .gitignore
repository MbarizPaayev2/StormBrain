**/.DS_Store
**/*.swp
*.bak
ngrok.zip
ngrok.tgz
ngrok

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Unrelated local projects kept in this folder ---
aise/

# --- Secrets / credentials: never commit these ---
# Session token (check-c.json), ngrok authtoken, admin hash and the Flask
# secret key all live under .secrets/ - outside the served web root.
.secrets/
# Legacy locations, still ignored in case an old checkout leaves a copy behind.
storm-web/check-c.json
storm-web/Settings.json
requirements.lock

# --- Harvested data and runtime artifacts: never commit these ---
storm-web/sessions/
storm-web/images/*
!storm-web/images/image.log
storm-web/sounds/*
!storm-web/sounds/sounds.log
storm-web/visitors/
storm-web/log/*
!storm-web/log/empty
storm-web/templates/*/result.txt
storm-web/templates/*/result.tmp.txt
